#include <windows.h>

1 ICON "assets/icon.ico"

1 VERSIONINFO
FILEVERSION APP_VERSION_NUM
PRODUCTVERSION APP_VERSION_NUM
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Minecraft Explorer"
            VALUE "FileVersion", APP_VERSION_TEXT
            VALUE "ProductName", "Minecraft Explorer"
            VALUE "ProductVersion", APP_VERSION_TEXT
            VALUE "OriginalFilename", "MinecraftExplorer.exe"
            VALUE "LegalCopyright", "Copyright (c) 2026 Minecraft Explorer contributors"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
